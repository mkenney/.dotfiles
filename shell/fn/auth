# auth aws --vault vfe-prod

SERVICE="aws"
if [ "aws" = "$1" ] || [ "docker" = "$1" ]; then
    SERVICE="$1"
    shift
fi

METHOD="vault"
if [ "--vault" = "$1" ]; then
    METHOD="vault"
    shift
elif [ "--sso" = "$1" ]; then
    METHOD="sso"
    shift
fi

ACCOUNT="vfe-test"
if [ "" != "$1" ]; then
    ACCOUNT=$1
    shift
fi

echo "Using method '${METHOD}' for account '${ACCOUNT}' and service '${SERVICE}'"

# main
case "$SERVICE" in
    # Docker
    "docker")
        # if [ "" = "$1" ]; then
        #     echo "Usage: auth docker [account] ($@)"
        #     return 1
        # fi

        echo "Authenticating docker into the '$ACCOUNT' ECR: $(get_account_id $ACCOUNT).dkr.ecr.us-east-1.amazonaws.com"
        # current_account_id=$(aws configure get default.sso_account_id)
        # set_aws_account $ACCOUNT
        aws ecr get-login-password --region us-east-1 | docker login \
            --username AWS \
            --password-stdin \
            $(get_account_id $ACCOUNT).dkr.ecr.us-east-1.amazonaws.com
        exit_code=$?; if [ "0" != "$exit_code" ]; then echo "Authenticating Docker into the '$ACCOUNT' account failed"; return $exit_code; fi
        # set_aws_account $current_account_id
    ;;

    # AWS account
    "aws")
        if [ "vault" = "$METHOD" ]; then
            while IFS= read -r line; do
                if [ "" != "${line}" ]; then
                    echo "Unsetting AWS var: ${line%%=*}"
                    unset "${line%%=*}"
                fi
            done <<< $(env | grep ^AWS_)
            echo "Authenticating into the '${ACCOUNT}' account using Vault"
            while IFS= read -r line; do
                export "$line"
            done <<< $(aws-vault exec $ACCOUNT -- env | grep ^AWS_)
            exit_code=$?;
            if [ "0" != "$exit_code" ]; then
                echo "Authenticating into the '${ACCOUNT}' account via Vault failed"
                return $exit_code
            fi
        else
            echo "Authenticating into the '${ACCOUNT}' account using SSO"
            aws sso login --profile $ACCOUNT
            exit_code=$?;
            if [ "0" != "$exit_code" ]; then
                echo "Authenticating into the '${ACCOUNT}' account via SSO failed"
                return $exit_code
            fi
        fi
    ;;

esac
