#!/usr/bin/env bash

#
# Create an ISO from a vido_ts folder
# The video_ts folder must be INSIDE of the specified directory
#
makedvd() {
	DIR=$1
	NAME=$(basename "${DIR}")
	echo "hdiutil makehybrid -udf -udf-volume-name \"${NAME}\" -o \"${NAME}.iso\" \"${DIR}\""
	hdiutil makehybrid -udf -udf-volume-name "${NAME}" -o "${NAME}.iso" "${DIR}"
}

#
# Extract about anything
#
extract () {
	if [ -f "$1" ] ; then
		case "$1" in
			*.tar.bz2) tar xvjf "$1" ;;
			*.tar.gz)  tar xvzf "$1" ;;
			*.bz2)     bunzip2 "$1" ;;
			*.rar)     unrar x "$1" ;;
			*.gz)      gunzip "$1" ;;
			*.tar)     tar xvf "$1" ;;
			*.tbz2)    tar xvjf "$1" ;;
			*.tgz)     tar xvzf "$1" ;;
			*.zip)     unzip "$1" ;;
			*.Z)       uncompress "$1" ;;
			*.7z)      7z x "$1" ;;
			*)         echo "'$1' cannot be extracted via >extract<" ;;
		esac
	else
		echo "'$1' is not a valid file"
	fi
}
alias decompress="extract"

#
# Get the size of the files in this dir
#
lsbytes() {
	echo -n $(ls -l | awk '/^-/{total += $5} END{printf "%.2f", total/1048576}')
}

#
# Reload one or more autoloaded functions (files on $fpath, e.g.
# ~/.dotfiles/shell/fn): drop the cached copy and re-arm autoload so the next
# call re-reads the edited file. Skips any name that has no definition file on
# $fpath — running autoload on an inline/sourced function would break it.
#
reload_function() {
	local fn dir found
	for fn in "$@"; do
		found=""
		for dir in $fpath; do [[ -r $dir/$fn ]] && { found=1; break; }; done
		if [[ -z $found ]]; then
			print -u2 "reload_function: no autoload file on \$fpath for \"$fn\"; skipping"
			continue
		fi
		unfunction "$fn" 2>/dev/null
		autoload -Uz "$fn"
	done
}
